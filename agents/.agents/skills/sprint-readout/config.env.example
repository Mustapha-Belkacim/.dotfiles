# Per-machine values for the sprint-readout skill.
#
#   cp config.env.example config.env   # then edit
#
# config.env is machine/employer-specific and is NOT committed.
# Everything here has a safe default, so an unset key is never fatal —
# the skill just asks you for the value instead.
# Format: KEY=value  (no spaces around =, quote only if the value has spaces)

# --- Identity shown on the deck ---
PRESENTER_NAME="Your Name"
TEAM_NAME="Your Team"
# Small text in the bottom-left of every slide. Defaults to TEAM_NAME.
FOOTER_LEFT=""

# --- Where things live ---
# Generated decks are written here.
OUTPUT_DIR="$HOME/presentations"
# Existing decks the skill reads as the style + narrative reference.
# Leave empty on a fresh setup; the first deck you like becomes the reference.
REFERENCE_DECKS_DIR="$HOME/presentations"

# --- Repositories to mine ---
REPO_SCAN_ROOT="$HOME/projects"
REPO_MAX_DEPTH=4
# "me" resolves to each repo's own `git config user.email`.
GIT_AUTHOR_EMAIL="me"

# --- Issue tracker ---
# jira | github | none — controls how the skill enriches ticket keys.
ISSUE_TRACKER=jira
# Ticket key prefix used in commit messages, e.g. ABC in "ABC-1234 fix: ...".
ISSUE_KEY_PREFIX=ABC
# Only for ISSUE_TRACKER=jira. Reused from ~/.copilot/jira.env if that exists.
JIRA_CLOUD_ID=your-org.atlassian.net
# Only for ISSUE_TRACKER=github, e.g. my-org/my-repo.
GITHUB_ISSUE_REPO=""

# --- Brand palette (optional) ---
# Any key left empty keeps the neutral default from assets/theme.css.
# Values are plain CSS colours.
BRAND_ACCENT=""        # primary accent: headings, KPI numbers, list markers
BRAND_ACCENT_2=""      # secondary accent
BRAND_WARM=""          # warm accent for "grad-warm" highlights
BRAND_ALERT=""         # problem / failure red
BRAND_GOLD=""          # fourth accent, used on card borders
BRAND_BG=""            # page background
BRAND_PANEL=""         # card surface
BRAND_BORDER=""        # hairline border
# The signature stripe under the title. A full CSS `background` value.
# Example three-colour flag: linear-gradient(90deg,#e2001a 0 33.3%,#f39200 33.3% 66.6%,#ffe500 66.6% 100%)
BRAND_STRIPE=""
