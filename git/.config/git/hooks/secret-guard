#!/usr/bin/env bash
#
# pre-commit secret guard.
#
# .gitignore only protects the files you predicted. This blocks the other case:
# a real value from a gitignored config file getting pasted into a tracked file
# (a template, a README, an agent instruction) and pushed to a public repo.
#
# Install into a repo:
#   ln -sf ~/.config/git/hooks/secret-guard .git/hooks/pre-commit
#
# Sources of "real values" (all optional, all gitignored where they live):
#   ~/.copilot/jira.env
#   ~/.agents/skills/*/config.env
#   ~/.config/git/secret-patterns   # one extra ERE per line, # comments allowed
#
# Bypass once (you had better be sure): git commit --no-verify
set -uo pipefail

fail=0
red() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

# 1 — never commit a secret-bearing config file, whatever directory it sits in.
while IFS= read -r f; do
  case "${f##*/}" in
    jira.env|config.env|.env|.env.*|*.pem|*.p12)
      red "secret-guard: refusing to commit '$f' (config/credential file)"
      fail=1
      ;;
  esac
done <<< "$staged"

diff="$(git diff --cached -U0 --diff-filter=ACMR)"

# 2 — literal values lifted from local, gitignored config files.
placeholder='^(|me|ABC|0+|Green|Team|Your .*|your-.*|my-org/my-repo|jira|github|none|[0-9]{1,3})$'
collect_values() {
  local file="$1" line key val
  [ -r "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue;; *=*) ;; *) continue;; esac
    key="${line%%=*}"; val="${line#*=}"
    val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
    [ "${#val}" -lt 4 ] && continue
    [[ "$val" =~ $placeholder ]] && continue
    case "$val" in \$HOME*|/*|\~*) continue;; esac   # paths, not secrets
    printf '%s\t%s\n' "$key" "$val"
  done < "$file"
}

while IFS=$'\t' read -r key val; do
  [ -z "${val:-}" ] && continue
  if grep -qF -- "$val" <<< "$diff"; then
    red "secret-guard: staged diff contains the real value of $key (from a gitignored config)"
    fail=1
  fi
done < <(
  collect_values "$HOME/.copilot/jira.env"
  for c in "$HOME"/.agents/skills/*/config.env; do collect_values "$c"; done
)

# 3 — shapes that are always wrong in a committed file.
declare -A patterns=(
  ["a real Atlassian host"]='[A-Za-z0-9][A-Za-z0-9-]*\.atlassian\.net'
  ["a real Jira custom field id"]='customfield_[0-9]*[1-9][0-9]*'
  ["an AWS access key id"]='AKIA[0-9A-Z]{16}'
  ["a private key block"]='-----BEGIN [A-Z ]*PRIVATE KEY-----'
  ["a GitHub token"]='gh[pousr]_[A-Za-z0-9]{20,}'
)
allow='your-org\.atlassian\.net|example\.atlassian\.net'
for label in "${!patterns[@]}"; do
  hits="$(grep -Eo -- "${patterns[$label]}" <<< "$diff" | grep -Ev -- "$allow" | sort -u)"
  if [ -n "$hits" ]; then
    red "secret-guard: staged diff looks like it contains $label:"
    sed 's/^/  /' <<< "$hits" >&2
    fail=1
  fi
done

# 4 — user-supplied extra patterns.
if [ -r "$HOME/.config/git/secret-patterns" ]; then
  while IFS= read -r pat || [ -n "$pat" ]; do
    case "$pat" in ''|\#*) continue;; esac
    if grep -Eq -- "$pat" <<< "$diff"; then
      red "secret-guard: staged diff matches a pattern from ~/.config/git/secret-patterns"
      fail=1
    fi
  done < "$HOME/.config/git/secret-patterns"
fi

if [ "$fail" -ne 0 ]; then
  red ""
  red "Commit blocked. Fix the value (use a placeholder) or, if this is a false positive:"
  red "  git commit --no-verify"
  exit 1
fi
exit 0
