# Per-machine Jira values for copilot-instructions.template.md
# Copy this file to jira.env, fill in your values, then run: ./generate-instructions.sh
#   cp jira.env.example jira.env
# jira.env is machine-specific and must NOT be committed (it holds your account id).
# Format: KEY=value  (no spaces around =, no surrounding quotes needed)

# --- Connection ---
JIRA_CLOUD_ID=your-org.atlassian.net
JIRA_BASE_URL=https://your-org.atlassian.net

# --- Project ---
JIRA_PROJECT=ABC
JIRA_PROJECT_NAME=Your Project Name

# --- Defaults for new tickets ---
JIRA_LABELS=["YOUR_LABEL"]
JIRA_RESPONSIBLE_TEAM=["YOUR_TEAM"]
JIRA_OWNER_NAME=YOUR_OWNER
JIRA_OWNER_ID=00000
JIRA_TRAFFIC_LIGHT_NAME=Green
JIRA_TRAFFIC_LIGHT_ID=00000
JIRA_ASSIGNEE_ACCOUNT_ID=your-account-id

# --- Custom field IDs (differ per Jira instance) ---
JIRA_CF_RESPONSIBLE_TEAM=customfield_00000
JIRA_CF_OWNER=customfield_00000
JIRA_CF_TRAFFIC_LIGHT=customfield_00000
JIRA_SPRINT_FIELD=customfield_00000

# --- Board ---
JIRA_BOARD_ID=00000
